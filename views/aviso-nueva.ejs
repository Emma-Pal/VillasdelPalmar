<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>

  <%- include('partials/portal-header') %>

  <section class="page-banner page-banner--plain">
    <div class="page-banner-content">
      <a href="/panel/avisos" class="back-link">← Volver a avisos</a>
      <span class="eyebrow">Mesa directiva</span>
      <h1>Nueva publicación</h1>
      <p class="page-banner-lead">Se firmará como <%= usuario.nombre %> — <%= usuario.cargo %>.</p>
    </div>
  </section>

  <section class="detail-sections">
    <div class="form-card" data-reveal style="max-width: 640px; margin: 0 auto;">
      <form action="/panel/avisos" method="POST" enctype="multipart/form-data" class="contact-form">
        <label>
          Categoría
          <select name="categoria" required>
            <option value="financiero">Estado financiero</option>
            <option value="mejora">Mejora</option>
            <option value="aviso">Aviso general</option>
          </select>
        </label>
        <label>
          Título
          <input type="text" name="titulo" placeholder="ej. Estado financiero — agosto 2026" required />
        </label>
        <label>
          Contenido
          <textarea name="cuerpo" rows="6" placeholder="Escribe el contenido de la publicación..." required></textarea>
        </label>
        <label>
          Archivo adjunto (opcional — PDF o imagen)
          <input type="file" name="archivo" accept=".pdf,.jpg,.jpeg,.png" />
        </label>
        <button type="submit" class="btn btn-primary">Publicar</button>
      </form>
    </div>
  </section>

  <%- include('partials/footer') %>

</body>
</html>
