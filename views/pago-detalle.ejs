<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>

  <%- include('partials/portal-header') %>

  <section class="page-banner page-banner--plain">
    <div class="page-banner-content">
      <a href="/panel/pagos" class="back-link">← Volver a pagos</a>
      <span class="eyebrow"><%= propietario.unidad %></span>
      <h1><%= propietario.nombre %></h1>
      <p class="page-banner-lead">
        <%= saldo > 0 ? ('Adeudo actual: $' + saldo.toLocaleString('es-MX')) : 'Al corriente, sin adeudos pendientes.' %>
      </p>
    </div>
  </section>

  <section class="detail-sections">
    <div class="tabla-wrap" data-reveal>
      <table class="tabla-pagos">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Movimiento</th>
            <th>Concepto</th>
            <th>Monto</th>
          </tr>
        </thead>
        <tbody>
          <% if (movimientos.length === 0) { %>
            <tr><td colspan="4">Sin movimientos registrados todavía.</td></tr>
          <% } %>
          <% movimientos.forEach(function (m) { %>
            <tr>
              <td><%= m.fecha %></td>
              <td>
                <span class="badge <%= m.tipo === 'cargo' ? 'badge--alerta' : 'badge--ok' %>">
                  <%= m.tipo === 'cargo' ? 'Cargo' : 'Pago' %>
                </span>
              </td>
              <td><%= m.concepto %></td>
              <td><%= m.tipo === 'cargo' ? '+' : '−' %>$<%= m.monto.toLocaleString('es-MX') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (usuario.tipo === 'mesa') { %>
      <div class="form-card" data-reveal>
        <span class="eyebrow">Mesa directiva</span>
        <h2>Agregar movimiento</h2>
        <form action="/panel/pagos/<%= propietario.id %>" method="POST" class="contact-form">
          <label>
            Fecha
            <input type="date" name="fecha" required />
          </label>
          <label>
            Tipo
            <select name="tipo" required>
              <option value="cargo">Cargo (se suma a la deuda)</option>
              <option value="pago">Pago (se resta de la deuda)</option>
            </select>
          </label>
          <label>
            Concepto
            <input type="text" name="concepto" placeholder="ej. Cuota de mantenimiento — septiembre 2026" required />
          </label>
          <label>
            Monto
            <input type="number" name="monto" min="0" step="0.01" placeholder="800" required />
          </label>
          <button type="submit" class="btn btn-primary">Guardar movimiento</button>
        </form>
      </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>

</body>
</html>
