<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>

  <%- include('partials/portal-header') %>

  <section class="panel-hero">
    <div class="panel-hero-content">
      <span class="eyebrow">Hola, <%= usuario.nombre %></span>
      <h1>Panel</h1>
    </div>
  </section>

  <section class="detail-sections">

    <div class="dashboard-grid" data-reveal>
      <div class="dashboard-card <%= avisosNuevos > 0 ? 'dashboard-card--alerta' : 'dashboard-card--ok' %>">
        <span class="eyebrow">Comunicación</span>
        <h2><%= avisosNuevos > 0 ? (avisosNuevos + ' ' + (avisosNuevos === 1 ? 'publicación nueva' : 'publicaciones nuevas')) : 'Estás al día' %></h2>
        <p><%= totalPublicaciones %> publicaciones en total entre estados financieros, mejoras y avisos.</p>
        <a href="/panel/avisos" class="btn btn-primary">Ver avisos</a>
      </div>

      <% if (usuario.tipo === 'mesa') { %>
        <div class="dashboard-card">
          <span class="eyebrow">Mesa directiva</span>
          <h2>Publicar algo nuevo</h2>
          <p>Comparte un estado financiero, una mejora o un aviso general.</p>
          <a href="/panel/avisos/nueva" class="btn btn-ghost-light">Nueva publicación</a>
        </div>
      <% } %>
    </div>

    <div class="section-heading" data-reveal style="margin-top: 24px;">
      <span class="eyebrow">Al día</span>
      <h2>Últimos avisos</h2>
    </div>

    <div class="publicaciones-list" data-reveal>
      <% if (ultimasPublicaciones.length === 0) { %>
        <p class="placeholder-note">Todavía no hay publicaciones.</p>
      <% } %>
      <% ultimasPublicaciones.forEach(function (pub) { %>
        <article class="publicacion-card">
          <span class="publicacion-categoria publicacion-categoria--<%= pub.categoria %>">
            <%= ({ financiero: 'Estado financiero', mejora: 'Mejora', aviso: 'Aviso' })[pub.categoria] %>
          </span>
          <h3><%= pub.titulo %></h3>
          <p><%- nl2br(pub.cuerpo) %></p>
          <footer>
            <span><%= pub.autor_nombre %> · <%= pub.autor_cargo %> — <%= pub.fecha %></span>
          </footer>
        </article>
      <% }); %>
    </div>

    <p style="text-align: center; margin-top: 8px;">
      <a href="/panel/avisos" class="back-link back-link--dark" style="display: inline-flex; margin: 0 auto;">Ver todos los avisos →</a>
    </p>

  </section>

  <%- include('partials/footer') %>

</body>
</html>
