<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>

  <%- include('partials/portal-header') %>

  <section class="page-banner page-banner--plain">
    <div class="page-banner-content">
      <a href="/panel/usuarios" class="back-link">← Volver a usuarios</a>
      <span class="eyebrow">Mesa directiva</span>
      <h1><%= usuarioEditado ? 'Editar usuario' : 'Nuevo usuario' %></h1>
      <% if (usuarioEditado) { %>
        <p class="page-banner-lead">Cambiar aquí el "Tipo" da o quita privilegios de mesa directiva.</p>
      <% } %>
    </div>
  </section>

  <section class="detail-sections">
    <div class="form-card" data-reveal style="max-width: 560px; margin: 0 auto;">
      <% if (error) { %>
        <p class="login-error"><%= error %></p>
      <% } %>

      <form
        action="<%= usuarioEditado ? `/panel/usuarios/${usuarioEditado.id}/editar` : '/panel/usuarios/nuevo' %>"
        method="POST"
        class="contact-form"
      >
        <label>
          Tipo de cuenta
          <select name="tipo" id="tipo-select" required>
            <option value="propietario" <%= usuarioEditado && usuarioEditado.tipo === 'propietario' ? 'selected' : '' %>>Propietario</option>
            <option value="mesa" <%= usuarioEditado && usuarioEditado.tipo === 'mesa' ? 'selected' : '' %>>Mesa directiva (privilegios de administrador)</option>
          </select>
        </label>

        <label>
          Nombre completo
          <input type="text" name="nombre" value="<%= usuarioEditado ? usuarioEditado.nombre : '' %>" required />
        </label>

        <label id="campo-unidad">
          Unidad (ej. "Depto 5")
          <input type="text" name="unidad" value="<%= usuarioEditado ? (usuarioEditado.unidad || '') : '' %>" />
        </label>

        <label id="campo-cargo">
          Cargo (ej. "Tesorero")
          <input type="text" name="cargo" value="<%= usuarioEditado ? (usuarioEditado.cargo || '') : '' %>" />
        </label>

        <label>
          Usuario (login)
          <input type="text" name="usuario" value="<%= usuarioEditado ? usuarioEditado.usuario : '' %>" required />
        </label>

        <label>
          <%= usuarioEditado ? 'Nueva contraseña (dejar en blanco para no cambiarla)' : 'Contraseña' %>
          <input type="password" name="password" <%= usuarioEditado ? '' : 'required' %> />
        </label>

        <button type="submit" class="btn btn-primary">
          <%= usuarioEditado ? 'Guardar cambios' : 'Crear usuario' %>
        </button>
      </form>
    </div>
  </section>

  <%- include('partials/footer') %>

</body>
</html>
